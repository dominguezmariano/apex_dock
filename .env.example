# Password para SYS / SYSTEM / PDBADMIN de la Oracle DB.
# Tambien se usa para APEX_PUBLIC_USER (que ORDS proxea).
# Reglas Oracle: minimo 8 chars, al menos 1 mayuscula, 1 minuscula, 1 numero
# y 1 caracter especial (de los permitidos: _ # $).
ORACLE_PWD=ChangeMe_2026

# Password del usuario ADMIN en el workspace INTERNAL de APEX (admin del sitio).
# Usado al loguear en http://localhost:8181/ords/apex_admin
APEX_ADMIN_PWD=Welcome_2026

# Email del ADMIN (solo se guarda en el perfil, no envia mail)
APEX_ADMIN_EMAIL=admin@example.com
